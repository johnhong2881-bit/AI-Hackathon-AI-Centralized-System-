  </svg>
  <Box style={{ position: 'relative', zIndex: 1, height: '720px', flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 32 }}>
    <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#FFFFFF', textAlign: 'center', lineHeight: 1.2 }}>
      One Prompt. One Goal.<br />
      <span style={{ backgroundImage: 'linear-gradient(135deg, #3B82F6 0%, #06B6D4 100%)', backgroundClip: 'text', color: 'transparent' }}>Zero Missed Deadlines.</span>
    </Text>
    <Box style={{ width: 80, height: 3, background: 'linear-gradient(90deg, #3B82F6, #06B6D4)', borderRadius: 2 }} />
    <Text style={{ fontSize: 24, color: '#94A3B8', textAlign: 'center' }}>PlanPilot AI</Text>
    <Text style={{ fontSize: 18, color: '#64748B', textAlign: 'center' }}>Track 2: WorkBuddy Agentic Solution</Text>
    <Box style={{ marginTop: 24, flexDirection: 'row', gap: 40 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
        <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#3B82F6' }} />
        <Text style={{ fontSize: 16, color: '#94A3B8' }}>6 Agents</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
        <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#06B6D4' }} />
