<Slide style={{ width: '1280px', height: '720px', padding: '20px 80px', background: '#FFFFFF', flexDirection: 'column' }}>
  <Box style={{ height: 100, flexDirection: 'column', justifyContent: 'center' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0F172A' }}>Group Assignments Are Broken</Text>
  </Box>
  <Box style={{ flex: 1, flexDirection: 'row', gap: 32 }}>
    <Box style={{ width: '60%', flexDirection: 'column', gap: 20, justifyContent: 'center' }}>
      <Box style={{ flexDirection: 'row', gap: 20, alignItems: 'flex-start', padding: 24, background: '#F8FAFC', borderRadius: 12, borderLeft: '4px solid #3B82F6' }}>
        <FAIcon name='file-text' style={{ fill: '#3B82F6', width: 36, height: 36 }} />
        <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0F172A' }}>Rubrics Are Vague</Text>
          <Text style={{ fontSize: 18, color: '#64748B', lineHeight: 1.5 }}>Students guess what matters. "Participation" could mean 10% or 40% with no clear breakdown.</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 20, alignItems: 'flex-start', padding: 24, background: '#F8FAFC', borderRadius: 12, borderLeft: '4px solid #06B6D4' }}>
        <FAIcon name='users' style={{ fill: '#06B6D4', width: 36, height: 36 }} />
        <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0F172A' }}>Work Distribution Is Unfair</Text>
          <Text style={{ fontSize: 18, color: '#64748B', lineHeight: 1.5 }}>One person ends up doing everything. No skill-based matching exists in current tools.</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 20, alignItems: 'flex-start', padding: 24, background: '#F8FAFC', borderRadius: 12, borderLeft: '4px solid #EF4444' }}>
        <FAIcon name='clock' style={{ fill: '#EF4444', width: 36, height: 36 }} />
        <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0F172A' }}>Deadlines Sneak Up</Text>
          <Text style={{ fontSize: 18, color: '#64748B', lineHeight: 1.5 }}>No early warning for at-risk tasks. Teams discover they're behind only days before submission.</Text>
        </Box>
      </Box>
    </Box>
    <Box style={{ width: '40%', flexDirection: 'column', gap: 24, justifyContent: 'center', padding: 32, background: 'linear-gradient(160deg, #3B82F6 0%, #06B6D4 100%)', borderRadius: 16 }}>
      <Text style={{ fontSize: 18, fontWeight: '600', color: '#FFFFFF', opacity: 0.8 }}>THE IMPACT</Text>
      <Box style={{ flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1 }}>73%</Text>
        <Text style={{ fontSize: 18, color: '#FFFFFF', opacity: 0.9, lineHeight: 1.4 }}>of students report uneven task distribution in group projects</Text>
      </Box>
      <Box style={{ width: '100%', height: 1, background: '#FFFFFF', opacity: 0.2 }} />
      <Box style={{ flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1 }}>12%</Text>
        <Text style={{ fontSize: 18, color: '#FFFFFF', opacity: 0.9, lineHeight: 1.4 }}>of student groups use any project management tool at all</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>TaskFlow AI</Text>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>02 / 10</Text>
  </Box>
</Slide>
