<Slide style={{ width: '1280px', height: '720px', padding: 0, background: '#0F172A', position: 'relative', overflow: 'hidden' }}>
  <svg width={1280} height={720} viewBox="0 0 1280 720" style={{ position: 'absolute', top: 0, left: 0 }}>
    <defs>
      <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stopColor="#1E3A5F" />
        <stop offset="50%" stopColor="#0F172A" />
        <stop offset="100%" stopColor="#1A2B4A" />
      </linearGradient>
      <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stopColor="#3B82F6" stopOpacity="0.15" />
        <stop offset="100%" stopColor="#06B6D4" stopOpacity="0.05" />
      </linearGradient>
    </defs>
    <rect width="1280" height="720" fill="url(#bgGrad)" />
    <rect x="0" y="0" width="1280" height="720" fill="url(#accentGrad)" />
    <circle cx="200" cy="150" r="120" fill="#3B82F6" opacity="0.08" />
    <circle cx="1100" cy="600" r="180" fill="#06B6D4" opacity="0.06" />
    <circle cx="950" cy="200" r="60" fill="#3B82F6" opacity="0.1" />
    <line x1="0" y1="360" x2="1280" y2="360" stroke="#3B82F6" strokeWidth="1" opacity="0.1" />
    <line x1="640" y1="0" x2="640" y2="720" stroke="#3B82F6" strokeWidth="1" opacity="0.08" />
  </svg>
  <Box style={{ position: 'relative', zIndex: 1, height: '720px', padding: '60px 80px', flexDirection: 'column', justifyContent: 'center', gap: 24 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
      <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#06B6D4' }} />
      <Text style={{ fontSize: 18, color: '#94A3B8', letterSpacing: 2 }}>TRACK 2: WORKBUDDY AGENTIC SOLUTION</Text>
    </Box>
    <Text style={{ fontSize: 72, fontWeight: 'bold', color: '#FFFFFF', letterSpacing: -2, lineHeight: 1.1 }}>
      TaskFlow AI
    </Text>
    <Text style={{ fontSize: 28, fontWeight: '600', lineHeight: 1.3, backgroundImage: 'linear-gradient(135deg, #3B82F6 0%, #06B6D4 100%)', backgroundClip: 'text', color: 'transparent' }}>
      Rubric-Aware Autonomous Deadline Defender
    </Text>
    <Box style={{ marginTop: 40, flexDirection: 'row', gap: 40 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
        <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#3B82F6' }}>6</Text>
        <Text style={{ fontSize: 16, color: '#94A3B8' }}>Agents</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
        <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#06B6D4' }}>14</Text>
        <Text style={{ fontSize: 16, color: '#94A3B8' }}>Features</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
        <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#10B981' }}>0</Text>
        <Text style={{ fontSize: 16, color: '#94A3B8' }}>Missed Deadlines</Text>
      </Box>
    </Box>
  </Box>
</Slide>
