# ============================================================
# TaskFlow AI — Environment Variables (Example)
# ============================================================
# Copy this file as .env and fill in your real values.
# .env is gitignored — your keys will never be committed.
# ============================================================

# === SovernStack API (GPT-OSS 120B) ===
# Used by external-llm.ts for real LLM calls
# Get your key from the SovernStack API playground
SOVERNSTACK_API_KEY=your_api_key_here
SOVERNSTACK_BASE_URL=https://api.sovernstack.com/v1
SOVERNSTACK_MODEL=gpt-oss-120b

# === WorkBuddy Cloud Service ===
# Fill after running workbuddy_cloud_service with action="activate"
WORKBUDDY_CLOUD_ENDPOINT=
WORKBUDDY_CLOUD_PUBLISHABLE_KEY=

# === App Config ===
# "mock" = use mock LLM (no API calls)
# "real"  = use SovernStack API (requires SOVERNSTACK_API_KEY)
NEXT_PUBLIC_LLM_MODE=mock
